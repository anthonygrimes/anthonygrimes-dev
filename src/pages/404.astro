---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
    <div class="flex grow flex-col items-center justify-center gap-4 px-4 py-12 text-center">
        <h1 class="text-display font-bold text-accent">404</h1>
        <p class="text-lead text-muted">This is not the page you are looking for.</p>
        <a href="/" class="font-semibold text-accent hover:text-accent-hover hover:underline underline-offset-4">&larr; Back home</a>
    </div>
</BaseLayout>
