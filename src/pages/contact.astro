---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";

const fieldClass = "block w-full rounded-md bg-surface text-fg px-3 py-2 text-base outline-1 -outline-offset-1 outline-border placeholder:text-muted focus:outline-2 focus:-outline-offset-2 focus:outline-accent";
---

<BaseLayout title="Contact">
    <Container>
        <form action="https://api.web3forms.com/submit" method="POST" id="form">
            <h1 class="text-h1 font-bold my-4">Get in touch</h1>

            <input type="hidden" name="access_key" value="9a39d952-c5c8-47e6-acbc-9d02c87a9088"/>
            <input type="hidden" name="subject" value="Contact Form"/>
            <input type="hidden" name="redirect" value="https://anthonygrimes.dev/thankyou"/>
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true"/>

            <div class="my-5">
                <label for="names" class="block text-base font-semibold">Name</label>
                <input type="text" name="names" id="names" autocomplete="name" required
                       class:list={[fieldClass, "mt-2"]}
                       placeholder="Billy Branson">
            </div>

            <div class="my-5">
                <label for="email" class="block text-base font-semibold">Email</label>
                <input type="email" name="email" id="email" autocomplete="email" required
                       class:list={[fieldClass, "mt-2"]}
                       placeholder="you@example.com">
            </div>

            <div class="my-5">
                <label for="message" class="block text-base font-semibold">Message</label>
                <textarea rows="5"
                          name="message"
                          id="message"
                          class:list={[fieldClass, "mt-2 resize-y"]}
                          placeholder="Be kind, rewind."
                          required></textarea>
            </div>

            <button type="submit"
                    class="mt-2 inline-flex min-h-11 items-center rounded-md bg-accent px-5 font-semibold text-on-accent hover:bg-accent-hover hover:cursor-pointer">
                Send message
            </button>
        </form>
    </Container>
</BaseLayout>
