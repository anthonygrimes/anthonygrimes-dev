---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/Container.astro";
import ExternalLink from "../components/icons/ExternalLink.astro";

const jobs = [
    {
        company: 'BR-DGE',
        dates: '2022 - Present',
        logo: '/images/timeline/bridge.png',
        url: 'https://br-dge.to',
        tagline: 'is building the next generation in payment orchestration.',
        detail: "At BR-DGE, I've delivered solutions providing network tokenization features for card schemes such as Visa and Mastercard; created automated data migration pipelines that allow the transfer of sensitive customer and card data across various platforms; processor integrations with Worldpay and Checkout; and I'm currently building support for our customer cashier product.",
    },
    {
        company: 'BlackRock',
        dates: '2021 - 2022',
        logo: '/images/timeline/blackrock.jpg',
        url: 'https://www.blackrock.com/uk',
        tagline: 'is building best-in-class investment tooling.',
        detail: 'At Blackrock, I worked on unifying our post-trade reconciliation tooling into a single source of truth. I was closely working with business analysts and existing engineering teams to ensure complete feature parity across existing systems. Our platform enabled a self-service, rules driven approach to data analysis and reporting which did not exist at the time.',
    },
    {
        company: 'JPMorganChase',
        dates: '2018 - 2021',
        logo: '/images/timeline/jpmchase.jpg',
        url: 'https://www.jpmorganchase.com',
        tagline: 'is building a complete financial platform, covering investments, banking, risk, research and more.',
        detail: 'At JPMC my exposure ranged from delivering a firm-wide controls and review suite which ensured application and team compliance, continuously ingesting and processing petabytes of data generated by internal applications, as well as, working directly with our trade teams on our Spectrum trade platform, enabling first-class trade tooling.',
    },
    {
        company: 'MTC Media',
        dates: '2017 - 2018',
        logo: '/images/timeline/mtc.png',
        url: 'https://www.mtc.co.uk',
        tagline: 'is building bespoke e-commerce solutions for every business.',
        detail: 'At MTC, I worked on improving our internal onboarding platform. Adding features such as guided training, profiles and comment systems. I additionally, assisted with the creation and maintenance of an internal development framework which enabled one-click setup and deployments for new customers.',
    },
];

const skills = [
    ['Programming', 'Java, Spring Boot, JavaScript, Typescript, Astro, TailwindCSS'],
    ['Cloud', 'AWS(EC2, S3, Lambda, Aurora), Kubernetes, Openshift, Terraform, Ansible'],
    ['Database', 'Oracle, PostgreSQL, MariaDB, Couchbase, SQLite'],
    ['Other', 'Kafka, RabbitMQ, Redis, gRPC, Docker, git'],
    ['Industry Knowledge', 'Payments, Trading, Financial Risk and Compliance, Cybersecurity'],
    ['Currently Learning', 'iOS Development'],
];

const elsewhere = [
    {label: 'GitHub', href: 'https://github.com/anthonygrimes'},
    {label: 'LinkedIn', href: 'https://www.linkedin.com/in/anthony-grimes/'},
];

const linkClass = 'font-bold text-accent hover:text-accent-hover hover:underline underline-offset-4';
---

<BaseLayout title="About">
    <Container>
        <h1 class="sr-only">About me</h1>

        <section class="mb-10">
            <h2 class="text-h1 font-bold my-4">Who am I</h2>
            <p class="text-lead">
                I'm Anthony, a software engineer specialising within the finance domain.
                With over a decades of experience, I've worked across various specialties such as financial risk
                and compliance, buy-side trading and most recently I have been working within the consumer
                payments space.
            </p>
        </section>

        <section class="mb-10">
            <h2 class="text-h1 font-bold my-4">Where I've worked</h2>
            <ol class="flex w-full flex-col">
                {jobs.map((job, i) => (
                    <li class="flex gap-x-4">
                        <div class="relative shrink-0">
                            {i < jobs.length - 1 && (
                                <div aria-hidden="true" class="absolute left-1/2 top-0 h-full w-0.5 -translate-x-1/2 bg-border"></div>
                            )}
                            <span class="relative z-10 grid size-10 sm:size-11 place-items-center rounded-full bg-surface ring-2 ring-border p-0.5">
                                <img src={job.logo}
                                     alt=""
                                     width="44" height="44"
                                     class="size-full rounded-full object-cover object-center"/>
                            </span>
                        </div>
                        <div class:list={[i < jobs.length - 1 ? 'pb-10' : 'pb-2']}>
                            <h3 class="text-h2 font-bold">{job.company}</h3>
                            <p class="text-base italic text-muted mb-2">{job.dates}</p>
                            <p class="mb-2">
                                <a class={linkClass} href={job.url}>{job.company} <ExternalLink/></a>
                                {' '}{job.tagline}
                            </p>
                            <p>{job.detail}</p>
                        </div>
                    </li>
                ))}
            </ol>
        </section>

        <section class="mb-10">
            <h2 class="text-h1 font-bold my-4">What I've worked with</h2>
            <dl class="grid gap-y-3 sm:grid-cols-[max-content_1fr] sm:gap-x-6">
                {skills.map(([label, value]) => (
                    <div class="contents">
                        <dt class="font-bold">{label}</dt>
                        <dd class="text-fg">{value}</dd>
                    </div>
                ))}
            </dl>
        </section>

        <section>
            <h2 class="text-h1 font-bold my-4">Elsewhere</h2>
            <ul class="flex flex-wrap gap-x-6 gap-y-2">
                {elsewhere.map(({label, href}) => (
                    <li><a class={linkClass} href={href}>{label} <ExternalLink/></a></li>
                ))}
            </ul>
        </section>
    </Container>
</BaseLayout>
