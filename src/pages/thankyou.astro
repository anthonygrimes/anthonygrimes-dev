---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Thank you">
    <div class="flex grow flex-col items-center justify-center gap-4 px-4 py-12 text-center">
        <h1 class="text-h1 font-bold text-balance max-w-2xl">Contact form submitted, thank you for reaching out!</h1>
        <p class="text-lead text-muted">I'll get back to you as soon as I can.</p>
        <a href="/" class="font-semibold text-accent hover:text-accent-hover hover:underline underline-offset-4">&larr; Back home</a>
    </div>
</BaseLayout>
